 "client_script": "frappe.web_form.after_load = () => {\n\tif (!frappe.web_form.doc.report_date) {\n\t\tfrappe.web_form.set_value(\"report_date\", frappe.datetime.get_today());\n\t}\n\tif (navigator.geolocation && frappe.web_form.is_new) {\n\t\tnavigator.geolocation.getCurrentPosition(\n\t\t\t(p) => {\n\t\t\t\tfrappe.web_form.set_value(\"latitude\", p.coords.latitude);\n\t\t\t\tfrappe.web_form.set_value(\"longitude\", p.coords.longitude);\n\t\t\t\tfrappe.show_alert({ message: __(\"GPS location captured\"), indicator: \"green\" });\n\t\t\t},\n\t\t\t() => frappe.show_alert({ message: __(\"Allow location access to tag this report\"), indicator: \"orange\" }),\n\t\t\t{ enableHighAccuracy: true, timeout: 15000 }\n\t\t);\n\t}\n};\n",
